# Business strategy docs (keep out of the public repo; kept locally, untracked)
#
# NOT purged from history. docs/ROADMAP.md, docs/project.md,
# docs/requirements.md and all 16 files under tasks/ were tracked and pushed,
# so they remain readable in origin/main's history. Ignoring them here only
# stops future edits from being published; purging the past needs a history
# rewrite (git filter-repo + force-push), which is deliberately not done here.
docs/business_plan_4_1_revision.md
docs/COMPETITIVE_LANDSCAPE.md
docs/project.md
docs/REQUIREMENTS.md
# Same file as the line above. macOS sets core.ignorecase=true, so the working
# tree's docs/REQUIREMENTS.md was tracked under this lower-case index path and
# .gitignore (which never applies to tracked files) silently did nothing.
# Untracked on 2026-08-14.
docs/requirements.md
docs/ROADMAP.md
tasks/


# Dilemma / PapyGreek benchmarks: regenerated artifacts (see tools/benchmarks/dilemma/README.md)
# Reproducible measurement outputs (numbers of record live in docs/benchmarks/*.md).
# Default is "ignored" so a new artifact never lands in the repo unreviewed --
# some of these carry PapyGreek-derived (CC BY-SA) content, see DATA_LICENSE.md
# section 5.1.
#
# The summaries re-admitted individually below are an AUDIT TRAIL for claims
# already made, not a substitute for re-running the pipeline.
# tools/benchmarks/dilemma/RESULTS_STATUS.md marks 26 of the 28 (23 Historical,
# 3 Unclassified) as outputs that must not support a NEW quantitative claim.
# They are kept so that a reader can see what the published numbers were
# computed from without the 3.7GB download and several hours a rerun costs.
# Check RESULTS_STATUS.md before citing any of them.
tools/benchmarks/dilemma/results_*.json
# ~155KB total. The two excluded files are the per-token candidate dumps:
# results_b3u.json (722KB) and results_strict_fixed.json (2.9MB).
!tools/benchmarks/dilemma/results_stats_*.json
!tools/benchmarks/dilemma/results_lm_*.json
!tools/benchmarks/dilemma/results_rerank_*.json
!tools/benchmarks/dilemma/results_zones_*.json
!tools/benchmarks/dilemma/results_altprob_*.json
!tools/benchmarks/dilemma/results_bert_*.json
!tools/benchmarks/dilemma/results_facet_*.json
!tools/benchmarks/dilemma/results_ddb_*.json
!tools/benchmarks/dilemma/results_propnoun_*.json
!tools/benchmarks/dilemma/results_decision_*.json
!tools/benchmarks/dilemma/results_coverage_fit.json
!tools/benchmarks/dilemma/results_b0.json
# External corpus checkouts / extractions (idp.data is a 68k-file DDbDP sparse checkout)
tools/benchmarks/dilemma/idp.data/
tools/benchmarks/dilemma/papygreek/
tools/benchmarks/dilemma/glaux_lemmas/
tools/benchmarks/dilemma/papygreek.zip
# Regenerated intermediate datasets, candidate dumps and indexes
tools/benchmarks/dilemma/dataset.jsonl
tools/benchmarks/dilemma/papygreek.json
tools/benchmarks/dilemma/pairs.jsonl
tools/benchmarks/dilemma/ddb_pairs.jsonl
tools/benchmarks/dilemma/ddb_pairs_strata.jsonl
tools/benchmarks/dilemma/dump_*.jsonl
# POS-tag dump: PapyGreek-derived gold labels (CC BY-SA), regenerated by rlb_postag.py
tools/benchmarks/dilemma/postags.jsonl
tools/benchmarks/dilemma/index.jsonl
tools/benchmarks/dilemma/ddb_index.jsonl
